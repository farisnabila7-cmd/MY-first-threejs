{
  "name": "tabel-periodik",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist .vite node_modules/.vite build",
    "prebuild": "npm run clean && npm run validate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
